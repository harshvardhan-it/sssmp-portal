{
  "name": "sssmp-portal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "seed:locations": "tsx src/scripts/seed-locations.ts",
    "import:provisional-blocks": "tsx src/scripts/import-provisional-blocks.ts",
    "seed:mp-districts": "tsx src/scripts/seed-mp-districts.ts",
    "bootstrap:super-admin": "tsx src/scripts/bootstrap-super-admin.ts",
    "expire:memberships": "tsx src/scripts/expire-memberships.ts",
    "report:membership-lifecycle": "tsx src/scripts/report-membership-lifecycle.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
