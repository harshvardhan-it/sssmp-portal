# ==============================================================================
# SSSMP PORTAL — ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env before running services. Never commit actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Node.js + Express + TypeScript)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database (MongoDB + Mongoose)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>


# Authentication & Security
# Use a long random value in the real .env file; never commit that value.
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d

# Cashfree Payment Gateway. Use sandbox until merchant activation and live credentials are approved.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_URL=
FRONTEND_URL=http://localhost:5173

# Legacy Razorpay credentials are retained only for reconciling historical Razorpay transactions.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test

# Local Storage Uploads Path (relative to backend or absolute)
STORAGE_UPLOAD_DIR=../storage/uploads

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="शासकीय शिक्षक संगठन मध्यप्रदेश"
VITE_ENABLE_ANALYTICS=false
